/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_SPI2_Init();
  MX_CRC_Init();
  /* USER CODE BEGIN 2 */
  HAL_SPI_Receive_DMA(&hspi2, (uint8_t*)dma_buffer, sizeof(SpiFrame_t));
  /* USER CODE END 2 */

  /* Infinite loop */
    /* USER CODE BEGIN WHILE */
    while (1)
    {
        /* --- BLOC 1 : TRAITEMENT DES DONNÉES REÇUES --- */
        if (rx_ready)
        {

            // pendant que le CPU accède au buffer.

            uint8_t calc_crc = 0;
            for(int i = 0; i < DATA_SIZE; i++) {
                calc_crc ^= cpu_buffer->data[i];
            }

            // Vérification de l'intégrité
            if (calc_crc == cpu_buffer->crc)
            {
                // Extraction de l'adresse de destination
                uint32_t target_addr;
                memcpy(&target_addr, &cpu_buffer->addr, sizeof(uint32_t));

                if (cpu_buffer->cmd == 0x01) // WRITE
                                {
                                    HAL_FLASH_Unlock();
                                    __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_ALL_ERRORS); // On nettoie les erreurs précédentes

                                    HAL_StatusTypeDef flash_status = HAL_OK;
                                    for (int i = 0; i < DATA_SIZE; i += 8)
                                    {
                                        uint64_t double_word = 0;
                                        memcpy(&double_word, &cpu_buffer->data[i], 8);

                                        flash_status = HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, target_addr + i, double_word);

                                        if (flash_status != HAL_OK) {
                                            // On stocke le code d'erreur spécifique de la puce
                                            dbg_cmd_err_count = HAL_FLASH_GetError();
                                            break;
                                        }
                                    }
                                    HAL_FLASH_Lock();

                                    if (flash_status == HAL_OK) {
                                        dbg_success_count++;
                                        HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
                                    }
                                }
                else if (cpu_buffer->cmd == 0x02) // COMMANDE : ERASE
                {
                    HAL_FLASH_Unlock();
                    __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_ALL_ERRORS);

                    uint32_t page_number = (target_addr - 0x08000000) / FLASH_PAGE_SIZE;
                    FLASH_EraseInitTypeDef EraseInitStruct = {
                        .TypeErase = FLASH_TYPEERASE_PAGES,
                        .Banks     = FLASH_BANK_1,
                        .Page      = page_number,
                        .NbPages   = 1
                    };

                    uint32_t PageError = 0;
                    if (HAL_FLASHEx_Erase(&EraseInitStruct, &PageError) == HAL_OK) {
                        dbg_success_count++;
                        // Feedback visuel court pour l'Erase
                        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
                        HAL_Delay(5);
                        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
                    }
                    HAL_FLASH_Lock();
                }

                else if (cpu_buffer->cmd == 0x04) // VERIFY
                {
                    uint32_t total_len = cpu_buffer->len;
                    uint32_t start_addr = cpu_buffer->addr;
                    uint8_t slave_checksum = 0;

                    // Calculer le checksum en Flash
                    for (uint32_t i = 0; i < total_len; i++) {
                        slave_checksum ^= *(__IO uint8_t*)(start_addr + i);
                    }

                    dbg_success_count++;

                    // ✅ CRITICAL: Attendre que le Master relance NSS
                    // Laisser le DMA terminer en paix
                    // ne PAS appeler HAL_SPI_Transmit tant que NSS est LOW

                    // On va signaler que la réponse est prête
                    volatile uint8_t verify_response_ready = 1;
                    volatile uint8_t verify_checksum = slave_checksum;
                }


            }
            else
            {
                dbg_crc_err_count++; // Le CRC ne correspond pas
            }

            // IMPORTANT : On libère le flag seulement ici
            rx_ready = 0;
        }

        /* --- BLOC 2 : RELANCE DU DMA (Seulement si nécessaire) --- */
        // On ne relance que si le NSS a bougé ET que le CPU a fini de traiter (rx_ready == 0)
        if (nss_triggered && rx_ready == 0)
        {
            nss_triggered = 0;
            HAL_SPI_Abort(&hspi2);
            __HAL_SPI_CLEAR_OVRFLAG(&hspi2);

            // On repart en écoute sur le buffer DMA libre
            HAL_SPI_Receive_DMA(&hspi2, (uint8_t*)dma_buffer, sizeof(SpiFrame_t));
        }

    /* USER CODE END WHILE */
    /* USER CODE BEGIN 3 */
    }
    /* USER CODE END 3 */ // <-- 1. FERMETURE DU "while (1)"
  /* USER CODE END 3 */
}

