/* USER CODE BEGIN 4 */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == GPIO_PIN_9) // NSS pin
    {
        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_9) == GPIO_PIN_RESET) // NSS descend
        {
            // Relancer DMA pour une nouvelle trame
            nss_triggered = 1;
            dbg_exti_count++;
        }
        else // NSS monte
        {
            // ✅ NSS haut : si on doit envoyer une réponse VERIFY
            if (verify_response_ready) {
                verify_response_ready = 0;
                HAL_SPI_Transmit(&hspi2, &verify_checksum, 1, 100);
            }
        }
    }
}

void HAL_SPI_RxCpltCallback(SPI_HandleTypeDef *hspi)
{
    if (hspi->Instance == SPI2)
    {
        dbg_rx_count++; // DEBUG : Le DMA a reçu 520 octets

        SpiFrame_t *temp = dma_buffer;
        dma_buffer = cpu_buffer;
        cpu_buffer = temp;

        rx_ready = 1;
    }
}
