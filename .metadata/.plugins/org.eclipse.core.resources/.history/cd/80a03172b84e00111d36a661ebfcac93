/* USER CODE BEGIN PV */
SpiFrame_t buffer_A;
SpiFrame_t buffer_B;

SpiFrame_t *dma_buffer = &buffer_A;
SpiFrame_t *cpu_buffer = &buffer_B;

volatile uint8_t rx_ready = 0; // Flag de réception

volatile uint8_t nss_triggered = 0;

volatile uint32_t dbg_exti_count = 0;     // Nombre de fois où le NSS (PB9) est descendu
volatile uint32_t dbg_rx_count = 0;       // Nombre de fois où le DMA a fini de recevoir 520 octets
volatile uint32_t dbg_success_count = 0;  // Nombre de trames parfaites (CRC et CMD OK)
volatile uint32_t dbg_crc_err_count = 0;  // Nombre d'erreurs de CRC
volatile uint32_t dbg_cmd_err_count = 0;  // Nombre de commandes inconnues
volatile uint8_t verify_response_ready = 0;
volatile uint8_t verify_checksum = 0;
/* USER CODE END PV */

