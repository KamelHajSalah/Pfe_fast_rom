#define DATA_SIZE 512

// Structure de la trame de 520 octets
typedef struct __attribute__((packed)) {
    uint8_t  cmd;           // 0x01: Write, 0x02: Erase, 0x03: Jump
    uint32_t addr;          // Adresse Flash de destination
    uint16_t len;           // Toujours 512
    uint8_t  data[DATA_SIZE]; // Les données à flasher
    uint8_t  crc;           // XOR de vérification
} SpiFrame_t;
