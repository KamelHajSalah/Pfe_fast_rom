static HAL_StatusTypeDef Safe_Flash_Write(uint32_t target_addr, uint8_t *data_ptr, uint16_t length)
{
    HAL_FLASH_Unlock();
    __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_ALL_ERRORS);

    HAL_StatusTypeDef flash_status = HAL_OK;

    // Écrire par double-mots (8 octets)
    for (uint32_t i = 0; i < length; i += 8)
    {
        uint64_t double_word = 0;
        uint16_t to_copy = (length - i) >= 8 ? 8 : (length - i);
        memcpy(&double_word, &data_ptr[i], to_copy);

        flash_status = HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD,
                                        target_addr + i,
                                        double_word);

        if (flash_status != HAL_OK) {
            dbg_cmd_err_count = HAL_FLASH_GetError();
            break;
        }
    }

    HAL_FLASH_Lock();
    return flash_status;
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_SPI2_Init();
  MX_CRC_Init();
  /* USER CODE BEGIN 2 */
  HAL_SPI_Receive_DMA(&hspi2, (uint8_t*)dma_buffer, sizeof(SpiFrame_t));
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  /* Infinite loop */
    /* USER CODE BEGIN WHILE */
    while (1)
    {
        /* --- BLOC 1 : TRAITEMENT DES DONNÉES REÇUES --- */
    	/* --- BLOC 1 : TRAITEMENT DES DONNÉES REÇUES --- */
    	    if (rx_ready)
    	    {
    	        // ✅ Calcul du CRC sur les 512 octets
    	        uint8_t calc_crc = 0;
    	        for(int i = 0; i < DATA_SIZE; i++) {
    	            calc_crc ^= cpu_buffer->data[i];
    	        }

    	        // ✅ Vérification d'intégrité
    	        if (calc_crc == cpu_buffer->crc)
    	        {
    	            uint32_t target_addr;
    	            memcpy(&target_addr, &cpu_buffer->addr, sizeof(uint32_t));

    	            // ✅ COMMANDE 0x01 : WRITE
    	            if (cpu_buffer->cmd == 0x01)
    	            {
    	                if (Safe_Flash_Write(target_addr, cpu_buffer->data, DATA_SIZE) == HAL_OK) {
    	                    dbg_success_count++;
    	                    HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
    	                } else {
    	                    dbg_cmd_err_count++;
    	                }
    	            }

    	            // ✅ COMMANDE 0x02 : ERASE
    	            else if (cpu_buffer->cmd == 0x02)
    	            {
    	                HAL_FLASH_Unlock();
    	                __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_ALL_ERRORS);

    	                uint32_t page_number = (target_addr - 0x08000000) / FLASH_PAGE_SIZE;
    	                FLASH_EraseInitTypeDef EraseInitStruct = {
    	                    .TypeErase = FLASH_TYPEERASE_PAGES,
    	                    .Banks     = FLASH_BANK_1,
    	                    .Page      = page_number,
    	                    .NbPages   = 1
    	                };

    	                uint32_t PageError = 0;
    	                if (HAL_FLASHEx_Erase(&EraseInitStruct, &PageError) == HAL_OK) {
    	                    dbg_success_count++;
    	                    HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
    	                    HAL_Delay(5);
    	                    HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
    	                } else {
    	                    dbg_cmd_err_count++;
    	                }
    	                HAL_FLASH_Lock();
    	            }

    	            // ✅ COMMANDE 0x04 : VERIFY
    	            else if (cpu_buffer->cmd == 0x04)
    	            {
    	                uint32_t total_len = cpu_buffer->len;
    	                uint32_t start_addr = target_addr;
    	                uint8_t slave_checksum = 0;

    	                // Calcul du XOR réel en Flash
    	                for (uint32_t i = 0; i < total_len; i++) {
    	                    slave_checksum ^= *(__IO uint8_t*)(start_addr + i);
    	                }

    	                dbg_success_count++;

    	                // ✅ Envoi immédiat au Master
    	                HAL_SPI_Transmit(&hspi2, &slave_checksum, 1, 100);
    	            }
    	        }
    	        else
    	        {
    	            dbg_crc_err_count++;  // Erreur CRC détectée
    	        }

    	        // ✅ Libérer le flag seulement après traitement complet
    	        rx_ready = 0;
    	    }

    	    /* --- BLOC 2 : RELANCE DU DMA --- */
    	    if (nss_triggered && rx_ready == 0)
    	    {
    	        nss_triggered = 0;
    	        HAL_SPI_Abort(&hspi2);
    	        __HAL_SPI_CLEAR_OVRFLAG(&hspi2);

    	        // Relancer la réception
    	        HAL_SPI_Receive_DMA(&hspi2, (uint8_t*)dma_buffer, sizeof(SpiFrame_t));
    	    }

    /* USER CODE END WHILE */
    /* USER CODE BEGIN 3 */
    }
    /* USER CODE END 3 */ // <-- 1. FERMETURE DU "while (1)"
  /* USER CODE END 3 */
}

